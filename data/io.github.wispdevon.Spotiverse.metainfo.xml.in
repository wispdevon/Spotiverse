<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
	<id>io.github.wispdevon.Spotiverse</id>
	<launchable type="desktop-id">io.github.wispdevon.Spotiverse.desktop</launchable>
	<name>Spotiverse</name>
	<summary>Spotify-style synced lyrics for the current track</summary>
	<developer id="io.github.wispdevon">
		<name>wispdevon</name>
	</developer>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>Apache-2.0</project_license>
	<categories>
		<category>GTK</category>
		<category>Utility</category>
	</categories>
	<description>
		<p>
			A Spotify lyrics companion that follows the song currently
			playing and displays synced lyrics when timestamps are available. Features:
		</p>
		<ul>
			<li>Spotify-style active lyric highlighting</li>
			<li>Automatic refresh when the current song changes</li>
			<li>Keyboard zoom controls</li>
		</ul>
	</description>

	<branding>
		<color type="primary" scheme_preference="light">#1DB954</color>
		<color type="primary" scheme_preference="dark">#1ED760</color>
	</branding>

	<releases>
	  <release version="1.0.0" date="2026-09-27">
			<description>
				<p>This release transforms the app into Spotiverse:</p>
				<ul>
					<li>Rename the app ID to io.github.wispdevon.Spotiverse</li>
					<li>Install the application as spotiverse</li>
					<li>Add Spotify-style synced lyrics with active line tracking</li>
					<li>Add automatic refresh when the current Spotify song changes</li>
					<li>Add local .env configuration and a configurable Spotify callback URI</li>
					<li>Add keyboard lyric zoom controls</li>
					<li>Refresh the README and app branding</li>
				</ul>
			</description>
	  </release>
	  <release version="0.1.8" date="2025-05-26">
			<description>
				<p>This release adds the following improvements:</p>
				<ul>
					<li>Improved window layout</li>
					<li>Enhanced lyrics sanitizer</li>
				</ul>
			</description>
	  </release>
		<release version="0.1.7" date="2025-04-14">
			<description>
				<p>This release adds the following improvements:</p>
				<ul>
					<li>Fix redirect URI for spotify authentication</li>
					<li>Update dependencies</li>
				</ul>
			</description>
	  </release>
	  <release version="0.1.6" date="2025-01-02">
			<description>
				<p>This release adds the following improvements:</p>
				<ul>
					<li>Update dependencies</li>
				</ul>
			</description>
	  </release>
	  <release version="0.1.5" date="2024-07-23">
			<description>
				<p>This release adds the following improvements:</p>
				<ul>
					<li>Better, Readable lyrics preview</li>
					<li>Token generation workflow improvement</li>
					<li>Fix refresh shortcut</li>
					<li>Other minor fixes</li>
				</ul>
			</description>
	  </release>
	  <release version="0.1.3" date="2024-07-06">
			<description>
				<p>This release adds the following improvements:</p>
				<ul>
					<li>Integrate Spotify refresh token generation</li>
					<li>Improve UI</li>
				</ul>
			</description>
	  </release>
	  <release version="0.1.2" date="2024-05-28">
			<description>
				<p>This release adds the following improvements:</p>
				<ul>
					<li>Fix app crashing for invalid tokens</li>
					<li>Fix incorrect lyrics for some songs</li>
				</ul>
			</description>
	  </release>
	  <release version="0.1.1" date="2024-05-27">
			<description>
				<p>This release adds the following improvements:</p>
				<ul>
					<li>Maintanin contrast in theme colors</li>
					<li>Use AdwStatusPage to display status</li>
					<li>Improved error messages</li>
				</ul>
			</description>
	  </release>
	</releases>

	<url type="homepage">https://github.com/wispdevon/Spotiverse</url>
	<content_rating type="oars-1.1" />
	<screenshots>
		<screenshot type="default">
			<image type="source">https://raw.githubusercontent.com/wispdevon/Spotiverse/main/images/verse-song.png</image>
			<caption>Lyrics of current playing song</caption>
		</screenshot>
		<screenshot>
			<image type="source">https://raw.githubusercontent.com/wispdevon/Spotiverse/main/images/verse-dark.png</image>
			<caption>Works in Dark mode</caption>
		</screenshot>
		<screenshot>
			<image type="source">https://raw.githubusercontent.com/wispdevon/Spotiverse/main/images/verse-preferences.png</image>
			<caption>Store API secrets</caption>
		</screenshot>
		<screenshot>
			<image type="source">https://raw.githubusercontent.com/wispdevon/Spotiverse/main/images/verse-adaptive.png</image>
			<caption>Adaptive window</caption>
		</screenshot>
		<screenshot>
			<image type="source">https://raw.githubusercontent.com/wispdevon/Spotiverse/main/images/verse-paginated.png</image>
			<caption>Paginated view displays previously played songs</caption>
		</screenshot>
	</screenshots>
</component>
